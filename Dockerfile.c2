# syntax=docker/dockerfile:1
FROM rust:latest AS builder

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --release -p nw-server

FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/* \
    && groupadd --system nw && useradd --system --gid nw --create-home nw

COPY --from=builder /app/target/release/nw-server /usr/local/bin/nw-server

USER nw
EXPOSE 8081

ENTRYPOINT ["nw-server"]
