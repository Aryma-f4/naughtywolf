# Local web portal. Copy to .env when creating a new configuration.
NAUGHTYWOLF_DATABASE_URL=sqlite:naughtywolf.db?mode=rwc
NAUGHTYWOLF_BIND=127.0.0.1:8080
NAUGHTYWOLF_EVIDENCE_DIR=evidence

# Generate a unique value with: openssl rand -hex 32
# Keep the same value across restarts to preserve signed sessions.
NAUGHTYWOLF_SESSION_SECRET=replace-with-a-unique-secret-of-at-least-32-bytes
NAUGHTYWOLF_COOKIE_SECURE=false

# Replace before using the portal's C2 routes.
NAUGHTYWOLF_C2_PSK=replace-with-a-unique-lab-shared-key

# Separate tunnel secret used by the official hackerschoice/gsocket sidecar.
# Enter this same value in the payload wizard when Protocol = GSocket.
GSOCKET_SECRET=replace-with-a-different-unique-gsocket-secret
# Raw C2 stays private. Compose overrides this to its internal network address.
NAUGHTYWOLF_TCP_BIND=127.0.0.1:4630
NAUGHTYWOLF_TCP_PROTOCOL=gs
RUST_LOG=info,naughtywolf=debug

# Native server/console settings use NW_*; see .env.example.c2.
# Older Sliver components use SLIVER_CONFIG_DIR and DATABASE_URL;
# those settings are not required by the current SQLite portal.
